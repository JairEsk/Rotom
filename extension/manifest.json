{
  "manifest_version": 3,
  "name": "R.O.T.O.M.",
  "short_name": "ROTOM",
  "description": "Remover Of Trash & Obsolete Mails - scan and bulk-delete large or old Gmail messages.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "R.O.T.O.M."
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://gmail.googleapis.com/*"
  ],
  "key": "",
  "oauth2": {
    "client_id": "844123707926-f3gmfcdgkqskdudkht2l2j5f6nmu9rfm.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.modify",
      "email",
      "profile"
    ]
  }
}